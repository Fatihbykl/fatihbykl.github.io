---
interface Props {
  title: string;
  description: string;
  genre: string;
  image?: string;
  releaseYear?: string;
  itchUrl?: string;
}

const {
  title,
  description,
  genre,
  image,
  releaseYear = '2024',
  itchUrl = 'https://itch.io',
} = Astro.props;
---

<div class="group tech-card rounded-lg overflow-hidden flex flex-col justify-between">
  
  <div>
    <!-- Banner / Capsule Art Area -->
    <div class="relative h-36 w-full bg-neutral-900/80 border-b border-neutral-800/80 overflow-hidden flex items-center justify-center">
      
      {image ? (
        <!-- Image with fallback -->
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover object-center group-hover:scale-[1.04] transition-transform duration-300"
          loading="lazy"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="hidden absolute inset-0 flex-col items-center justify-center gap-2 bg-neutral-900/90">
          <div class="w-8 h-8 rounded-md bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="6" width="20" height="12" rx="3"/>
              <path d="M6 12h4m-2-2v4"/>
              <circle cx="17" cy="10" r="1" fill="currentColor"/>
              <circle cx="15" cy="13" r="1" fill="currentColor"/>
            </svg>
          </div>
          <span class="text-[10px] font-mono text-neutral-500">Image not found</span>
        </div>
      ) : (
        <!-- Default Technical Placeholder -->
        <div class="flex flex-col items-center gap-2">
          <div class="w-9 h-9 rounded-md bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-blue-400 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="2" y="6" width="20" height="12" rx="3"/>
              <path d="M6 12h4m-2-2v4"/>
              <circle cx="17" cy="10" r="1" fill="currentColor"/>
              <circle cx="15" cy="13" r="1" fill="currentColor"/>
            </svg>
          </div>
        </div>
      )}

      <!-- Genre Badge & Year Floating Overlay -->
      <div class="absolute top-2.5 left-2.5 z-10">
        <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-200 bg-neutral-950/95 backdrop-blur-sm px-2.5 py-1 rounded border border-neutral-700/80 font-medium shadow-sm">
          {genre}
        </span>
      </div>

      <span class="absolute bottom-2 right-2.5 z-10 text-[10px] font-mono text-neutral-300 bg-neutral-950/90 backdrop-blur-sm px-2 py-0.5 rounded border border-neutral-700/80 font-medium">
        {releaseYear}
      </span>
    </div>

    <!-- Content Area -->
    <div class="p-4 space-y-2">
      <h3 class="text-base font-bold text-white group-hover:text-blue-400 transition-colors">
        {title}
      </h3>
      <p class="text-xs sm:text-sm text-neutral-300 line-clamp-3 leading-relaxed font-normal">
        {description}
      </p>
    </div>
  </div>

  <!-- Single Itch.io Action Button -->
  <div class="p-4 pt-2">
    <a
      href={itchUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center gap-2 px-3 py-2.5 text-xs font-semibold rounded-md border border-neutral-700 bg-neutral-900/90 hover:bg-neutral-800 hover:border-neutral-600 text-neutral-200 hover:text-white transition-all duration-200 shadow-sm"
    >
      <svg class="w-3.5 h-3.5 fill-current opacity-80" viewBox="0 0 24 24">
        <path d="M2.5 5.5A2.5 2.5 0 0 1 5 3h14a2.5 2.5 0 0 1 2.5 2.5v1.2a2.5 2.5 0 0 1-1.3 2.2 2.5 2.5 0 0 1 1.3 2.2v5.4a4.5 4.5 0 0 1-4.5 4.5h-10A4.5 4.5 0 0 1 2.5 16.5V11.1a2.5 2.5 0 0 1 1.3-2.2A2.5 2.5 0 0 1 2.5 6.7V5.5zm6.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm6 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM9 15.5a3 3 0 0 0 6 0H9z"/>
      </svg>
      <span>Play on Itch.io</span>
      <svg class="w-3 h-3 text-neutral-500 ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </div>

</div>

