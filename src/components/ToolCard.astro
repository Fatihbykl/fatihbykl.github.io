---
interface Props {
  name: string;
  category: string;
  description: string;
  docUrl: string;
  image?: string;
  assetStoreUrl?: string;
  isPublished?: boolean;
}

const {
  name,
  category,
  description,
  docUrl,
  image,
  assetStoreUrl = 'https://assetstore.unity.com',
  isPublished = true,
} = Astro.props;

const isComingSoon = isPublished === false;
---

<div class="group tech-card rounded-lg overflow-hidden flex flex-col justify-between h-full">
  
  <!-- Banner / Visual Area -->
  <div class="relative h-36 w-full shrink-0 bg-neutral-900/80 border-b border-neutral-800/80 overflow-hidden flex items-center justify-center">
    
    {image ? (
      <!-- Image with fallback -->
      <img
        src={image}
        alt={name}
        class="w-full h-full object-cover object-center group-hover:scale-[1.04] transition-transform duration-300"
        loading="lazy"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="hidden absolute inset-0 flex-col items-center justify-center gap-2 bg-neutral-900/90">
        <div class="w-8 h-8 rounded-md bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m18 15-6-6-6 6"/>
            <rect width="18" height="18" x="3" y="3" rx="2"/>
          </svg>
        </div>
        <span class="text-[10px] font-mono text-neutral-500">Image not found</span>
      </div>
    ) : (
      <!-- Default Technical Placeholder -->
      <div class="flex flex-col items-center gap-2">
        <div class="w-9 h-9 rounded-md bg-neutral-950 border border-neutral-800 flex items-center justify-center text-neutral-400 group-hover:text-blue-400 transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m18 15-6-6-6 6"/>
            <rect width="18" height="18" x="3" y="3" rx="2"/>
          </svg>
        </div>
      </div>
    )}

    <!-- Category Badge Floating Overlay -->
    <div class="absolute top-2.5 left-2.5 z-10">
      <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-200 bg-neutral-950/95 backdrop-blur-sm px-2.5 py-1 rounded border border-neutral-700/80 font-medium shadow-sm">
        {category}
      </span>
    </div>

    <!-- Coming Soon Badge on Banner -->
    {isComingSoon && (
      <div class="absolute top-2.5 right-2.5 z-10">
        <span class="inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-wider text-amber-300 bg-neutral-950/95 backdrop-blur-sm px-2.5 py-1 rounded border border-amber-500/50 font-semibold shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          Coming Soon
        </span>
      </div>
    )}
  </div>

  <!-- Body Content + Actions Container -->
  <div class="relative flex-1 flex flex-col justify-between">
    <!-- Inner content blurred and disabled when isComingSoon is true -->
    <div class={`flex-1 flex flex-col justify-between ${isComingSoon ? 'filter blur-md select-none pointer-events-none opacity-25 transition-all' : ''}`}>
      <!-- Content Area -->
      <div class="p-4 space-y-2 flex-1">
        <h3 class="text-base font-bold text-white group-hover:text-blue-400 transition-colors">
          {name}
        </h3>
        <p class="text-xs sm:text-sm text-neutral-300 line-clamp-3 leading-relaxed font-normal">
          {description}
        </p>
      </div>

      <!-- Action Buttons (White Primary + Bordered Secondary) - Pinned to bottom with mt-auto -->
      <div class="p-4 pt-2 flex items-center gap-2 mt-auto shrink-0">
        <!-- Docs Link (Primary CTA) -->
        <a
          href={docUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2.5 text-xs font-semibold rounded-md bg-white hover:bg-neutral-100 text-neutral-950 transition-colors shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-neutral-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          <span>Docs</span>
        </a>

        <!-- Asset Store Link (Secondary CTA) -->
        {assetStoreUrl && (
          <a
            href={assetStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 text-xs font-medium rounded-md border border-neutral-700 bg-neutral-900/90 hover:bg-neutral-800 hover:border-neutral-600 text-neutral-200 hover:text-white transition-colors"
            title="Asset Store"
          >
            <span>Asset Store</span>
            <svg class="w-3 h-3 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Coming Soon Overlay -->
    {isComingSoon && (
      <div class="absolute inset-0 z-20 flex flex-col items-center justify-center p-4 text-center bg-black/40 backdrop-blur-xs">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-neutral-900/95 border border-amber-500/50 text-amber-300 text-xs font-mono font-bold tracking-wider uppercase shadow-xl shadow-amber-500/10 mb-1">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Coming Soon
        </div>
        <p class="text-[11px] text-neutral-300 font-mono mt-0.5">
          Under review & preparation
        </p>
      </div>
    )}
  </div>

</div>

