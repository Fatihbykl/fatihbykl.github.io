---
import MainLayout from '../../layouts/MainLayout.astro';
import { tools, contactLinks } from '../../i18n/data';

const promoImageSrc = '/images/publisher-banner.png';
const publisherTools = tools;
---

<MainLayout 
  title="Fuzzy Logic Labs — Unity Asset Store Publisher" 
  description="Official publisher portal for Fuzzy Logic Labs. High-performance Unity tools, Tensio physics simulation, FuzzyIDE editor suite, and customer support."
  showNavItems={true}
>


  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-20">
    
    <!-- OPEN HERO SECTION: Visual-Centric, Bold High-Contrast Typography, No Boxed Background, No Lights -->
    <section class="relative mb-16 sm:mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Left Column: Title, Short Description, Contact Channels (7 cols) -->
        <div class="lg:col-span-7 space-y-6 sm:space-y-8">
          
          <div class="space-y-4">
            <!-- Main Title: Bigger, High-Impact & Crisp White -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
              Fuzzy Logic Labs
            </h1>

            <!-- Short Description: Crisp, Clean & Highly Legible -->
            <p class="text-base sm:text-lg text-neutral-200 leading-relaxed max-w-xl font-normal">
              Welcome to Fuzzy Logic Labs! I craft performant and easy-to-use assets designed to streamline your workflow. My goal is to handle the complex logic so you can focus on building great games.
            </p>
          </div>

          <!-- Direct Contact Channels: Email & Discord -->
          <div class="pt-2">
            <div class="flex flex-wrap items-center gap-3">
              <!-- Discord Button -->
              <a
                href={contactLinks.publisher.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 px-5 py-2.5 text-sm font-semibold rounded-lg bg-[#5865F2] hover:bg-[#4752C4] text-white transition-all duration-200 shadow-md hover:-translate-y-0.5 active:translate-y-0"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                </svg>
                <span>Discord Community</span>
              </a>

              <!-- Email Button -->
              <a
                href={`mailto:${contactLinks.publisher.supportEmail}`}
                class="inline-flex items-center justify-center gap-2.5 px-5 py-2.5 text-sm font-medium rounded-lg border border-neutral-700 bg-neutral-900/90 hover:bg-neutral-800 hover:border-neutral-500 text-neutral-200 hover:text-white transition-all duration-200 backdrop-blur-md shadow-sm hover:-translate-y-0.5 active:translate-y-0"
              >
                <svg class="w-4 h-4 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                <span>{contactLinks.publisher.supportEmail}</span>
              </a>
            </div>
          </div>

        </div>

        <!-- Right Column: Visual Showcase Frame (5 cols) - Clean & Precise -->
        <div class="lg:col-span-5">
          <!-- 3:2 Aspect Ratio Showcase Container -->
          <div class="relative w-full aspect-[1200/800] rounded-xl overflow-hidden border border-white/15 bg-neutral-950 shadow-2xl backdrop-blur-sm">
            
            <img
              src={promoImageSrc}
              alt="Fuzzy Logic Labs 1200x800 Promotional Showcase"
              class="w-full h-full object-cover object-center hover:scale-[1.02] transition-transform duration-700 ease-out"
              loading="eager"
              onerror="this.style.display='none'; document.getElementById('promo-fallback').style.display='flex';"
            />

            <!-- Subtle Gloss Gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-white/[0.04] pointer-events-none"></div>

            <!-- Fallback Frame (if image file missing) -->
            <div id="promo-fallback" class="hidden absolute inset-0 flex-col items-center justify-center p-6 text-center bg-neutral-950">
              <div class="w-10 h-10 rounded-md bg-neutral-900 border border-neutral-800 flex items-center justify-center text-blue-400 mb-2">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
              <span class="text-xs font-mono text-neutral-300">Fuzzy Logic Labs Visual</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- OFFICIAL PACKAGES SHOWCASE -->
    <div class="pt-10 border-t border-neutral-800/80">
      <div class="mb-8">
        <span class="text-xs font-mono uppercase tracking-wider text-blue-400 font-semibold">Available Packages</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1.5 tracking-tight">Publisher Tools Catalog</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {publisherTools.map(tool => {
          const isComingSoon = tool.isPublished === false;
          return (
            <div class="tech-card rounded-xl overflow-hidden flex flex-col justify-between h-full group">
              
              <!-- Tool Header / Cover Area -->
              <div class="relative h-80 w-full shrink-0 bg-neutral-900/80 overflow-hidden flex items-center justify-center border-b border-neutral-800">
                
                {tool.image ? (
                  <img
                    src={tool.image}
                    alt={tool.name}
                    class="w-full h-full object-cover object-center group-hover:scale-[1.03] transition-transform duration-300"
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden absolute inset-0 flex-col items-center justify-center gap-2 bg-neutral-900">
                    <div class="w-9 h-9 rounded-md bg-neutral-950 border border-neutral-800 flex items-center justify-center text-blue-400 font-mono font-semibold text-xs">
                      {tool.name.substring(0, 2).toUpperCase()}
                    </div>
                  </div>
                ) : (
                  <div class="w-10 h-10 rounded-md bg-neutral-950 border border-neutral-800 flex items-center justify-center text-blue-400 font-mono font-semibold text-sm">
                    {tool.name.substring(0, 2).toUpperCase()}
                  </div>
                )}

                <!-- Floating Badges -->
                <div class="absolute top-2.5 left-2.5 z-10">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-200 bg-neutral-950/90 backdrop-blur-sm px-2.5 py-1 rounded border border-neutral-700/80 font-medium">
                    {tool.category}
                  </span>
                </div>

                <div class="absolute bottom-2.5 right-2.5 z-10">
                  <span class="text-[10px] font-mono text-neutral-300 bg-neutral-950/90 backdrop-blur-sm px-2.5 py-1 rounded border border-neutral-700/80 font-medium">
                    {tool.unityVersion}
                  </span>
                </div>

                <!-- Coming Soon Badge on Banner -->
                {isComingSoon && (
                  <div class="absolute top-2.5 right-2.5 z-10">
                    <span class="inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-wider text-amber-300 bg-neutral-950/95 backdrop-blur-sm px-2.5 py-1 rounded border border-amber-500/50 font-semibold shadow-sm">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                      Coming Soon
                    </span>
                  </div>
                )}
              </div>

              <!-- Tool Body + Actions Container -->
              <div class="relative flex-1 flex flex-col justify-between">
                <!-- Inner content blurred when isComingSoon -->
                <div class={`flex-1 flex flex-col justify-between h-full ${isComingSoon ? 'filter blur-md select-none pointer-events-none opacity-25 transition-all' : ''}`}>
                  <!-- Tool Body Content -->
                  <div class="p-6 space-y-3.5 flex-1">
                    <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors">
                      {tool.name}
                    </h3>
                    <p class="text-sm text-neutral-300 leading-relaxed font-normal">
                      {tool.description}
                    </p>

                    {tool.features && tool.features.length > 0 && (
                      <div class="space-y-2 pt-3 border-t border-neutral-800/80">
                        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-400 font-semibold">Key Features:</h4>
                        <ul class="space-y-1.5">
                          {tool.features.map(f => (
                            <li class="flex items-start gap-2.5 text-xs text-neutral-300">
                              <svg class="w-3.5 h-3.5 text-blue-400 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                              </svg>
                              <span class="leading-relaxed">{f}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>

                  <!-- Tool Footer Actions - Fixed at bottom with mt-auto -->
                  <div class="p-6 pt-0 mt-auto flex flex-col sm:flex-row items-center gap-3 shrink-0">
                    <!-- Documentation Button (White Primary) -->
                    <a
                      href={tool.docUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-md bg-white hover:bg-neutral-100 text-neutral-950 transition-colors shadow-sm"
                    >
                      <svg class="w-3.5 h-3.5 text-neutral-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                      </svg>
                      <span>Read Documentation</span>
                    </a>

                    <!-- Asset Store Button (Bordered Secondary) -->
                    {tool.assetStoreUrl && (
                      <a
                        href={tool.assetStoreUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-xs font-medium rounded-md border border-neutral-700 bg-neutral-900 hover:bg-neutral-800 hover:border-neutral-600 text-neutral-200 hover:text-white transition-colors"
                      >
                        <span>View on Asset Store</span>
                        <svg class="w-3 h-3 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                          <polyline points="15 3 21 3 21 9"/>
                          <line x1="10" y1="14" x2="21" y2="3"/>
                        </svg>
                      </a>
                    )}
                  </div>
                </div>

                <!-- Coming Soon Overlay -->
                {isComingSoon && (
                  <div class="absolute inset-0 z-20 flex flex-col items-center justify-center p-6 text-center bg-black/40 backdrop-blur-xs">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-neutral-900/95 border border-amber-500/50 text-amber-300 text-xs font-mono font-bold tracking-widest uppercase shadow-2xl shadow-amber-500/10 mb-2">
                      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                      Coming Soon
                    </div>
                    <p class="text-xs text-neutral-300 font-mono max-w-xs mt-1">
                      Currently under review & release preparation
                    </p>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</MainLayout>
